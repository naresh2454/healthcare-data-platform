# ── Zookeeper ─────────────────────────────────────────────────────────────────
ZOOKEEPER_PORT=2181

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_HOST_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_BROKER_ID=1
KAFKA_REPLICATION_FACTOR=1
KAFKA_AUTO_CREATE_TOPICS=true
KAFKA_UI_PORT=8085
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=healthcare
MYSQL_USER=hc_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST_PORT=3308
MYSQL_CONTAINER_PORT=3306

# ── Flink ─────────────────────────────────────────────────────────────────────
FLINK_JOBMANAGER_PORT=8081
FLINK_UI_PORT=8081
FLINK_RPC_PORT=6123
FLINK_BLOB_PORT=6124
FLINK_QUERY_PORT=6125
FLINK_TASK_SLOTS=4
FLINK_PARALLELISM=2
FLINK_CHECKPOINT_INTERVAL=10000

# ── Flink Job Submission ──────────────────────────────────────────────────────
# alerts_job.py excluded — it runs as a standalone container (flink-alerts-job).
FLINK_REST_URL=http://localhost:8081
JOB_SCRIPTS=healthcare_job.py,monitoring_job.py
MAX_RETRIES=5
RETRY_DELAY=30
POLL_INTERVAL=10

# ── Producer ──────────────────────────────────────────────────────────────────
SEND_INTERVAL=2.0
MAX_EVENTS=100

# ── Gmail SMTP (for alerts_job email notifications) ───────────────────────────
# Use a Gmail App Password (not your account password).
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password
ALERT_FROM_EMAIL=your_gmail@gmail.com
